<Window x:Class="NetworkChat.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetworkChat" Height="650" Width="1000"
        MinHeight="500" MinWidth="760" Background="#171923"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252938"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A4052"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#222635" CornerRadius="10" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="NETWORK CHAT" Foreground="White" FontSize="20"
                           FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="StatusText" Text="Не подключено" Foreground="#F59E0B"
                               VerticalAlignment="Center" Margin="8"/>
                    <TextBlock x:Name="OnlineText" Text="Онлайн: 0" Foreground="White"
                               VerticalAlignment="Center" Margin="8"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#222635" CornerRadius="10" Padding="10" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock Text="ПОЛЬЗОВАТЕЛИ" Foreground="#AAB1C5" FontWeight="Bold"
                               DockPanel.Dock="Top" Margin="4,4,4,12"/>
                    <ListBox x:Name="UsersList" Background="Transparent" Foreground="White"
                             BorderThickness="0"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="#222635" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock Text="Сообщения" Foreground="White" FontSize="16"
                               FontWeight="SemiBold" DockPanel.Dock="Top" Margin="4,0,4,10"/>
                    <ListBox x:Name="MessagesList" Background="Transparent" Foreground="White"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageInput" Height="42" VerticalContentAlignment="Center"
                     KeyDown="MessageInput_KeyDown" ToolTip="Введите сообщение"/>
            <Button Grid.Column="1" Content="Отправить" Click="Send_Click"/>
            <Button x:Name="WeatherButton" Grid.Column="2" Content="Погода" Click="Weather_Click"
                    ToolTip="Получить текущую погоду в Екатеринбурге"/>
            <Button Grid.Column="3" Content="Статистика" Click="Stats_Click"/>
        </Grid>
    </Grid>
</Window>
